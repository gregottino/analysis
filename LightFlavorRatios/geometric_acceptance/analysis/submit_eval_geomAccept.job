Universe           = vanilla
Executable         = run_eval_geoacceptance.sh
Output          = /sphenix/tg/tg01/hf/gregoryottino/lightFlavorMultRatio/local_corrections/geometric_acceptance/log/eval_geoacceptance_$(Process).out
Error           = /sphenix/tg/tg01/hf/gregoryottino/lightFlavorMultRatio/local_corrections/geometric_acceptance/log/eval_geoacceptance_$(Process).err
Log             = /tmp/log_gregoryottino/eval_geoacceptance_$(Process).log
Initialdir      = .
PeriodicHold    = (NumJobStarts>=1 && JobStatus == 1)
request_memory     = 2GB
Priority           = 20
job_lease_duration = 3600
Arguments          = $(Process)
Queue 10000
