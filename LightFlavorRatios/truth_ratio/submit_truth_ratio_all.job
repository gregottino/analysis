Universe           = vanilla
Executable         = run_truth_ratio_all.sh
Output          = /sphenix/tg/tg01/hf/gregoryottino/lightFlavorMultRatio/truth_ratio/logs/truth_ratio_$(Process).out
Error           = /sphenix/tg/tg01/hf/gregoryottino/lightFlavorMultRatio/truth_ratio/logs/truth_ratio_$(Process).err
Log             = /tmp/log_gregoryottino/truth_ratio_$(Process).log
Initialdir      = .
PeriodicHold    = (NumJobStarts>=1 && JobStatus == 1)
request_memory     = 2GB
Priority           = 20
job_lease_duration = 3600
Arguments          = $(Process)
Queue 10000
